# Claude Code
.claude/
!.claude/skills/
!.claude/skills/**

# Git worktrees
.worktrees/

# Superpowers working memory — kept local, not tracked (this repo runs private).
# docs/wip/ is the ratified path (AD-0001); docs/archive/ holds retired raw.
# docs/superpowers/ and .scratch/ stay ignored as a safety net for upstream
# tools that still default to those paths.
docs/wip/
docs/archive/
docs/superpowers/
.scratch/

# Upskill consumer-side install artifacts. metapowers is a source registry;
# generated per-client outputs (Claude/Copilot/opencode) and the lockfile
# belong to consumer projects, not the SSOT registry. Each contributor can
# install whatever bundles they want locally without polluting the tree.
.agents/
.github/skills/
.upskill-lock.json
.vscode/

# Editor / LSP state
.markspec/
