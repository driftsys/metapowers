diff --git a/pkg/cli.py b/pkg/cli.py
index 7143ee4..5462b2f 100644
--- a/pkg/cli.py
+++ b/pkg/cli.py
@@ -8,14 +8,23 @@ from pkg.client import Client, Config, fetchAll
 
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
+    parser.add_argument(
+        "--retries",
+        type=int,
+        default=Config.retries,
+        help="number of attempts per request (default: %(default)s)",
+    )
     sub = parser.add_subparsers(dest="command", required=True)
     sub.add_parser("list", help="list all items")
     return parser
 
 
 def main(argv=None, transport=None, out=sys.stdout) -> int:
-    args = build_parser().parse_args(argv)
-    client = Client(Config(), transport)
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.retries < 1:
+        parser.error("--retries must be at least 1")
+    client = Client(Config(retries=args.retries), transport)
     if args.command == "list":
         for item in fetchAll(client, "/items"):
             print(item["name"], file=out)
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 8931036..1be6699 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,5 +1,6 @@
 import io
 import unittest
+from contextlib import redirect_stderr
 
 from pkg.cli import main
 
@@ -13,3 +14,18 @@ class CliTest(unittest.TestCase):
         }
         self.assertEqual(main(["list"], transport=transport, out=out), 0)
         self.assertEqual(out.getvalue(), "alpha\nbeta\n")
+
+    def test_retries_option_sets_attempts(self):
+        calls = []
+
+        def transport(m, u, p, t):
+            calls.append(m)
+            return {"status": 500, "body": None}
+
+        with self.assertRaises(RuntimeError):
+            main(["--retries", "5", "list"], transport=transport, out=io.StringIO())
+        self.assertEqual(len(calls), 5)
+
+    def test_retries_option_rejects_zero(self):
+        with self.assertRaises(SystemExit), redirect_stderr(io.StringIO()):
+            main(["--retries", "0", "list"], transport=None, out=io.StringIO())
