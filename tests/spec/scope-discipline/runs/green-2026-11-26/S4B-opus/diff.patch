diff --git a/tests/test_cli.py b/tests/test_cli.py
index 8931036..4bdb2ca 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,3 +1,4 @@
+import contextlib
 import io
 import unittest
 
@@ -13,3 +14,33 @@ class CliTest(unittest.TestCase):
         }
         self.assertEqual(main(["list"], transport=transport, out=out), 0)
         self.assertEqual(out.getvalue(), "alpha\nbeta\n")
+
+    def _transport(self, m, u, p, t):
+        return {
+            "status": 200,
+            "body": {"items": [{"name": "alpha"}, {"name": "beta"}, {"name": "gamma"}]},
+        }
+
+    def test_list_limit_truncates(self):
+        out = io.StringIO()
+        self.assertEqual(
+            main(["list", "--limit", "2"], transport=self._transport, out=out), 0
+        )
+        self.assertEqual(out.getvalue(), "alpha\nbeta\n")
+
+    def test_list_limit_zero_prints_nothing(self):
+        out = io.StringIO()
+        self.assertEqual(
+            main(["list", "--limit", "0"], transport=self._transport, out=out), 0
+        )
+        self.assertEqual(out.getvalue(), "")
+
+    def test_list_limit_larger_than_items(self):
+        out = io.StringIO()
+        main(["list", "--limit", "10"], transport=self._transport, out=out)
+        self.assertEqual(out.getvalue(), "alpha\nbeta\ngamma\n")
+
+    def test_list_limit_rejects_negative(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                main(["list", "--limit", "-1"], transport=self._transport)
