+
+    def test_verbose_prints_request_url_to_stderr(self):
+        out, err = io.StringIO(), io.StringIO()
+        transport = lambda m, u, p, t: {"status": 200, "body": {"items": []}}
+        with contextlib.redirect_stderr(err):
+            main(["--verbose", "list"], transport=transport, out=out)
