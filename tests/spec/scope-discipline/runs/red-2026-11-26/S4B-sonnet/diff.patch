--- a/pkg/cli.py
+++ b/pkg/cli.py
@@ -9,14 +9,27 @@ from pkg.client import Client, Config, fetchAll
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
     sub = parser.add_subparsers(dest="command", required=True)
-    sub.add_parser("list", help="list all items")
+    list_parser = sub.add_parser("list", help="list all items")
+    list_parser.add_argument(
+        "--limit", type=non_negative_int, help="show at most this many items"
+    )
     return parser
 
 
+def non_negative_int(value: str) -> int:
+    number = int(value)
+    if number < 0:
+        raise argparse.ArgumentTypeError("must be >= 0")
+    return number
+
+
 def main(argv=None, transport=None, out=sys.stdout) -> int:
     args = build_parser().parse_args(argv)
     client = Client(Config(), transport)
     if args.command == "list":
-        for item in fetchAll(client, "/items"):
+        items = fetchAll(client, "/items")
+        if args.limit is not None:
+            items = items[: args.limit]
+        for item in items:
             print(item["name"], file=out)
     return 0
