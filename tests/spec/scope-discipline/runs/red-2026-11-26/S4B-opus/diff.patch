diff --git a/pkg/cli.py b/pkg/cli.py
index 7143ee4..665a857 100644
--- a/pkg/cli.py
+++ b/pkg/cli.py
@@ -6,10 +6,20 @@ import sys
 from pkg.client import Client, Config, fetchAll
 
 
+def _positive_int(value: str) -> int:
+    n = int(value)
+    if n < 1:
+        raise argparse.ArgumentTypeError(f"must be a positive integer: {value}")
+    return n
+
+
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
     sub = parser.add_subparsers(dest="command", required=True)
-    sub.add_parser("list", help="list all items")
+    list_parser = sub.add_parser("list", help="list all items")
+    list_parser.add_argument(
+        "--limit", type=_positive_int, help="print at most N items"
+    )
     return parser
 
 
@@ -17,6 +27,9 @@ def main(argv=None, transport=None, out=sys.stdout) -> int:
     args = build_parser().parse_args(argv)
     client = Client(Config(), transport)
     if args.command == "list":
-        for item in fetchAll(client, "/items"):
+        items = fetchAll(client, "/items")
+        if args.limit is not None:
+            items = items[: args.limit]
+        for item in items:
             print(item["name"], file=out)
     return 0
