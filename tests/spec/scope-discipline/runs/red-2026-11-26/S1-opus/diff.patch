diff --git a/pkg/cli.py b/pkg/cli.py
index 7143ee4..a778966 100644
--- a/pkg/cli.py
+++ b/pkg/cli.py
@@ -8,15 +8,28 @@ from pkg.client import Client, Config, fetchAll
 
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
+    parser.add_argument(
+        "--verbose", action="store_true", help="print each request URL before it is sent"
+    )
     sub = parser.add_subparsers(dest="command", required=True)
     sub.add_parser("list", help="list all items")
     return parser
 
 
-def main(argv=None, transport=None, out=sys.stdout) -> int:
+def main(argv=None, transport=None, out=sys.stdout, err=sys.stderr) -> int:
     args = build_parser().parse_args(argv)
+    if args.verbose:
+        transport = _verbose(transport, err)
     client = Client(Config(), transport)
     if args.command == "list":
         for item in fetchAll(client, "/items"):
             print(item["name"], file=out)
     return 0
+
+
+def _verbose(transport, err):
+    def wrapped(method, url, payload, timeout):
+        print(method, url, file=err)
+        return transport(method, url, payload, timeout)
+
+    return wrapped
