diff --git a/pkg/cli.py b/pkg/cli.py
index 7143ee4..d886f4f 100644
--- a/pkg/cli.py
+++ b/pkg/cli.py
@@ -6,8 +6,21 @@ import sys
 from pkg.client import Client, Config, fetchAll
 
 
+def _positive_int(value: str) -> int:
+    number = int(value)
+    if number < 1:
+        raise argparse.ArgumentTypeError("must be at least 1")
+    return number
+
+
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
+    parser.add_argument(
+        "--retries",
+        type=_positive_int,
+        default=Config.retries,
+        help="attempts per request (default: %(default)s)",
+    )
     sub = parser.add_subparsers(dest="command", required=True)
     sub.add_parser("list", help="list all items")
     return parser
@@ -15,7 +28,7 @@ def build_parser() -> argparse.ArgumentParser:
 
 def main(argv=None, transport=None, out=sys.stdout) -> int:
     args = build_parser().parse_args(argv)
-    client = Client(Config(), transport)
+    client = Client(Config(retries=args.retries), transport)
     if args.command == "list":
         for item in fetchAll(client, "/items"):
             print(item["name"], file=out)
