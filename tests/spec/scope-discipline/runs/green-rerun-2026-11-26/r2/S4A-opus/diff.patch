+def _non_negative_int(text: str) -> int:
+    value = int(text)
+    if value < 0:
+        raise argparse.ArgumentTypeError("must be 0 or greater")
+    return value
+
+
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog="items")
+    parser.add_argument(
+        "--retries",
+        type=_non_negative_int,
+        default=Config.retries,
+        help="times to retry a request after a server error (default: %(default)s)",
+    )
     sub = parser.add_subparsers(dest="command", required=True)
     sub.add_parser("list", help="list all items")
     return parser
@@ -15,7 +28,7 @@ def build_parser() -> argparse.ArgumentParser:
 
 def main(argv=None, transport=None, out=sys.stdout) -> int:
     args = build_parser().parse_args(argv)
