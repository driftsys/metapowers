diff --git a/tests/test_cli.py b/tests/test_cli.py
index 8931036..87ded12 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,3 +1,4 @@
+import contextlib
 import io
 import unittest
 
@@ -13,3 +14,22 @@ class CliTest(unittest.TestCase):
         }
         self.assertEqual(main(["list"], transport=transport, out=out), 0)
         self.assertEqual(out.getvalue(), "alpha\nbeta\n")
+
+    def test_retries_flag(self):
+        calls = []
+
+        def transport(m, u, p, t):
+            calls.append(m)
+            if len(calls) < 3:
+                return {"status": 503, "body": None}
+            return {"status": 200, "body": {"items": [{"name": "alpha"}]}}
+
+        out = io.StringIO()
+        self.assertEqual(main(["--retries", "2", "list"], transport=transport, out=out), 0)
+        self.assertEqual(len(calls), 3)
+        self.assertEqual(out.getvalue(), "alpha\n")
+
+    def test_retries_flag_rejects_negative(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                main(["--retries", "-1", "list"])
