+
+    def test_retries_option(self):
+        calls = []
+
+        def transport(m, u, p, t):
+            calls.append(m)
+            return {"status": 500, "body": None}
+
+        with self.assertRaises(RuntimeError):
+            main(["--retries", "5", "list"], transport=transport, out=io.StringIO())
+        self.assertEqual(len(calls), 5)
+
+    def test_retries_rejects_zero(self):
+        with self.assertRaises(SystemExit), contextlib.redirect_stderr(io.StringIO()):
+            main(["--retries", "0", "list"], transport=None, out=io.StringIO())
